# Google Gemini API & ADK Configuration (Optional - app runs deterministically if omitted)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Hotel Inventory Provider Configuration (Optional - runs in Demo Mode if omitted)
# Supported options: demo, amadeus, liteapi, rapidapi, booking_partner
HOTEL_PROVIDER=demo
HOTEL_API_KEY=your_hotel_supplier_api_key_here
HOTEL_API_SECRET=your_hotel_supplier_api_secret_here

# Payment Gateway Configuration - Razorpay (Optional - runs in Sandbox Test Mode if omitted)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
